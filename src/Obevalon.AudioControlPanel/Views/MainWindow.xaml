<Window x:Class="Obevalon.AudioControlPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:Obevalon.AudioControlPanel.Localization"
        xmlns:vm="clr-namespace:Obevalon.AudioControlPanel.ViewModels"
        xmlns:audio="clr-namespace:Obevalon.AudioControlPanel.Core.Audio;assembly=Obevalon.AudioControlPanel.Core"
        xmlns:core="clr-namespace:Obevalon.AudioControlPanel.Core;assembly=Obevalon.AudioControlPanel.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{x:Static core:AppInfo.ProductName}"
        Icon="/Assets/app.ico"
        Width="400"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
  <StackPanel Margin="16">

    <!-- Header -->
    <StackPanel Orientation="Horizontal">
      <Image Source="/Assets/app.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
      <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{x:Static core:AppInfo.ProductName}" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource SecondaryText}">
          <Run Text="{loc:Loc Common_Version}" /><Run Text=" " /><Run Text="{x:Static core:AppInfo.Version}" />
        </TextBlock>
      </StackPanel>
    </StackPanel>

    <!-- Audio outputs -->
    <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Outputs_Header}" />
    <ItemsControl ItemsSource="{Binding Outputs}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:OutputDeviceViewModel}">
          <Button Style="{StaticResource ListRowButton}" Command="{Binding SwitchCommand}" ToolTip="{Binding SystemName}"
                  ToolTipService.ShowOnDisabled="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                         Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"
                         VerticalAlignment="Center" Visibility="Hidden" />

              <StackPanel Grid.Column="1">
                <TextBlock x:Name="DeviceName" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Note}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock x:Name="Status" Style="{StaticResource SecondaryText}" Visibility="Collapsed" />
              </StackPanel>
            </Grid>
          </Button>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDefault}" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
              <Setter TargetName="DeviceName" Property="FontWeight" Value="SemiBold" />
              <Setter TargetName="Status" Property="Visibility" Value="Visible" />
              <Setter TargetName="Status" Property="Text" Value="{loc:Loc Output_IsDefault}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static audio:AudioDeviceState.Disabled}">
              <Setter TargetName="DeviceName" Property="Opacity" Value="0.5" />
              <Setter TargetName="Status" Property="Visibility" Value="Visible" />
              <Setter TargetName="Status" Property="Text" Value="{loc:Loc DeviceState_Disabled}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static audio:AudioDeviceState.Unplugged}">
              <Setter TargetName="DeviceName" Property="Opacity" Value="0.5" />
              <Setter TargetName="Status" Property="Visibility" Value="Visible" />
              <Setter TargetName="Status" Property="Text" Value="{loc:Loc DeviceState_Unplugged}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMissing}" Value="True">
              <Setter TargetName="DeviceName" Property="Opacity" Value="0.5" />
              <Setter TargetName="Status" Property="Visibility" Value="Visible" />
              <Setter TargetName="Status" Property="Text" Value="{loc:Loc DeviceState_Missing}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="{x:Static audio:AudioDeviceState.NotPresent}">
              <Setter TargetName="DeviceName" Property="Opacity" Value="0.5" />
              <Setter TargetName="Status" Property="Visibility" Value="Visible" />
              <Setter TargetName="Status" Property="Text" Value="{loc:Loc DeviceState_NotPresent}" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{loc:Loc Outputs_None}" Margin="8,0" Style="{StaticResource SecondaryText}"
               Visibility="{Binding HasOutputs, Converter={StaticResource InverseBoolToVisibility}}" />

    <!-- Microphone -->
    <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Loc Microphone_Header}" />
    <StackPanel DataContext="{Binding Microphone}"
                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding DeviceName}" Margin="8,0,8,6" Style="{StaticResource SecondaryText}"
                 TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}" />
      <Grid Margin="8,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>

        <Button Command="{Binding ToggleMuteCommand}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
              <Setter Property="Content" Value="&#xE720;" />
              <Setter Property="ToolTip" Value="{loc:Loc Microphone_Mute}" />
              <Setter Property="AutomationProperties.Name" Value="{loc:Loc Microphone_Mute}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                  <Setter Property="Content" Value="&#xEC54;" />
                  <Setter Property="Foreground" Value="#E5484D" />
                  <Setter Property="BorderBrush" Value="#E5484D" />
                  <Setter Property="ToolTip" Value="{loc:Loc Microphone_Unmute}" />
                  <Setter Property="AutomationProperties.Name" Value="{loc:Loc Microphone_Unmute}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>

        <Slider Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                Value="{Binding Volume, Mode=TwoWay}"
                AutomationProperties.Name="{loc:Loc Microphone_Volume}" />

        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Run Text="{Binding Volume, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" %" />
        </TextBlock>
      </Grid>
    </StackPanel>
    <TextBlock Text="{loc:Loc Microphone_NotAvailable}" Margin="8,0" Style="{StaticResource SecondaryText}"
               Visibility="{Binding Microphone.IsAvailable, Converter={StaticResource InverseBoolToVisibility}}" />

    <!-- Error -->
    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E5484D" TextWrapping="Wrap" Margin="8,12,8,0">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Style.Triggers>
            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <!-- Footer -->
    <TextBlock Margin="0,16,0,0" Style="{StaticResource SecondaryText}">
      <Run Text="{x:Static core:AppInfo.Author}" /><Run Text=" · " /><Run Text="{x:Static core:AppInfo.LicenseName}" /><Run Text=" · " /><Hyperlink NavigateUri="{x:Static core:AppInfo.RepositoryUrl}" RequestNavigate="OnRequestNavigate"><Run Text="{loc:Loc Common_Repository}" /></Hyperlink>
    </TextBlock>
  </StackPanel>
</Window>
